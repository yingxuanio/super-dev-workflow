# Release build — the full online build pipeline for a macOS Developer ID app.
#
# Architecture (lumina standard):
#   - Triggers: a published tag (vX.Y.Z) OR manual workflow_dispatch.
#   - Manual dispatch is a REHEARSAL: it runs the exact production path but
#     publishes nothing — artifacts are uploaded as run artifacts and the
#     GitHub Release / distribution channel is never touched. This is how a
#     signing/secret/infra change is exercised before a real release.
#   - setup job resolves version once and proves PROVENANCE before any build
#     minutes are spent: the tag must point at a commit already merged into
#     the main branch, and (for stable releases) the tag must match the
#     project's marketing version. A rerun of a failed pipeline never
#     rebuilds on account of this job.
#   - Every signing credential lives in an EPHEMERAL keychain created in the
#     job and deleted in an `if: always()` cleanup step — a failed job must
#     not leave a keychain with an imported private key on a shared runner.
#   - The chain is: build → codesign verify → DMG → notarize → stapler staple
#     → stapler validate → mount the DMG and strictly verify the contained app
#     (spctl does not assess disk images). Each stage is a distinct step so
#     the failing stage is named in the run.
#   - Notarization prefers the App Store Connect API key (no 2FA fragility);
#     the app-specific password path is the documented fallback.
#   - The publish job is the only job with contents: write, and it waits for
#     the build; the cleanup job waits for everything.
#
# Tokens (replace): __APP_NAME__ __SCHEME__ __XCODEPROJ__ __BUNDLE_ID__
# Secrets: APPLE_CERTIFICATE (base64 p12), APPLE_CERTIFICATE_PASSWORD,
#   APPLE_ID + APPLE_ID_PASSWORD + APPLE_TEAM_ID (app-password notarization)
#   or APPLE_API_KEY_ID + APPLE_API_ISSUER + APPLE_API_KEY_P8 (preferred),
#   KEYCHAIN_PASSWORD (any random string, runner-local).
name: Release build

on:
  push:
    tags:
      - 'v*'
  workflow_dispatch:

# Never cancel a release mid-publish because someone dispatched another one.
concurrency:
  group: release-${{ github.ref }}
  cancel-in-progress: false

permissions:
  contents: read

# RELEASE_DIR is defined per-step: the runner context is not available
# at workflow/job level. github.run_id keeps the path stable across retries
# so a failed publish job can reuse a successful build's artifacts.

jobs:
  setup:
    name: Resolve version and prove provenance
    runs-on: [self-hosted, macOS]
    timeout-minutes: 5
    outputs:
      release_version: ${{ steps.resolve.outputs.release_version }}
      is_release: ${{ steps.resolve.outputs.is_release }}
    steps:
      - name: Checkout release ref
        uses: actions/checkout@v4
        with:
          ref: ${{ github.event_name == 'push' && github.ref || github.sha }}
          fetch-depth: 0

      - name: Check runner and resolve release context
        id: resolve
        env:
          EVENT_NAME: ${{ github.event_name }}
          TAG_NAME: ${{ github.ref_name }}
        run: |
          set -euo pipefail
          test "$(uname -s)" = "Darwin" || { echo "release builds require macOS" >&2; exit 1; }
          test "$(uname -m)" = "arm64" || { echo "release builds require Apple Silicon" >&2; exit 1; }

          if [[ "$EVENT_NAME" == "push" ]]; then
            is_release=true
            case "$TAG_NAME" in v*) release_version="${TAG_NAME#v}" ;; *) release_version="$TAG_NAME" ;; esac
            [[ "$release_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$ ]] || {
              echo "tag must be vX.Y.Z (semver): $TAG_NAME" >&2; exit 1;
            }
            # PROVENANCE: only commits already merged into the main branch
            # may release. The tag ref and the checked-out SHA are the same
            # commit on a tag push; anchor on the SHA.
            main_commit="$(git rev-parse origin/main 2>/dev/null || true)"
            test -n "$main_commit" || { echo "could not resolve origin/main" >&2; exit 1; }
            git merge-base --is-ancestor "$(git rev-parse HEAD)" "$main_commit" || {
              echo "refusing to build a release tag that is not merged into main" >&2
              exit 1
            }
            # VERSION CONSISTENCY: tag must match the project's marketing
            # version so the DMG the user sees and About panel agree.
            project_version="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' __APP_NAME__/Info.plist 2>/dev/null || \
              awk -F= '/MARKETING_VERSION/{gsub(/[ ;]/,"",$2); print $2; exit}' __XCODEPROJ__/project.pbxproj | head -1)"
            test "$project_version" = "$release_version" || {
              echo "tag v$release_version does not match project version '$project_version' — bump first" >&2
              exit 1
            }
          else
            # Rehearsal: build the current state of the dispatched ref.
            is_release=false
            release_version="$(awk -F= '/MARKETING_VERSION/{gsub(/[ ;]/,"",$2); print $2; exit}' __XCODEPROJ__/project.pbxproj | head -1)"
            [[ -n "$release_version" ]] || release_version="0.0.0-rehearsal"
          fi

          echo "release_version=$release_version" >> "$GITHUB_OUTPUT"
          echo "is_release=$is_release" >> "$GITHUB_OUTPUT"
          echo "Release version: $release_version (release=$is_release)"

      # Fresh on every FULL run; stable across re-running only a failed job.
      - name: Reset release dir
        env:
          # Machine-local /tmp: multiple runner processes share one machine,
          # each with a DIFFERENT RUNNER_TEMP — runner.temp splits the release
          # fleet (setup's dir invisible to the build runner). /tmp does not.
          RELEASE_DIR: /tmp/__APP_NAME__-release-${{ github.run_id }}
        run: |
          rm -rf "$RELEASE_DIR"
          mkdir -p "$RELEASE_DIR"

  build:
    name: Build, sign, notarize, staple
    runs-on: [self-hosted, macOS]
    timeout-minutes: 40
    needs: setup
    env:
      RELEASE_VERSION: ${{ needs.setup.outputs.release_version }}
      APPLE_CERTIFICATE: ${{ secrets.APPLE_CERTIFICATE }}
      APPLE_CERTIFICATE_PASSWORD: ${{ secrets.APPLE_CERTIFICATE_PASSWORD }}
      APPLE_ID: ${{ secrets.APPLE_ID }}
      APPLE_ID_PASSWORD: ${{ secrets.APPLE_ID_PASSWORD }}
      APPLE_TEAM_ID: ${{ secrets.APPLE_TEAM_ID }}
      APPLE_API_KEY_ID: ${{ secrets.APPLE_API_KEY_ID }}
      APPLE_API_ISSUER: ${{ secrets.APPLE_API_ISSUER }}
      APPLE_API_KEY_P8: ${{ secrets.APPLE_API_KEY_P8 }}
      KEYCHAIN_PASSWORD: ${{ secrets.KEYCHAIN_PASSWORD }}
    steps:
      - name: Checkout release ref
        uses: actions/checkout@v4
        with:
          ref: ${{ github.event_name == 'push' && github.ref || github.sha }}
          fetch-depth: 1

      - name: Verify release dir exists (fail fast on fleet split)
        env:
          RELEASE_DIR: /tmp/__APP_NAME__-release-${{ github.run_id }}
        run: |
          test -d "$RELEASE_DIR" || {
            echo "error: $RELEASE_DIR is missing — the release jobs landed on" >&2
            echo "error: machines with separate /tmp. All release jobs of one run" >&2
            echo "error: must execute on the same machine (see RELEASE_DIR note)." >&2
            exit 1
          }

      - name: Prepare signing credentials (ephemeral keychain)
        run: |
          set -euo pipefail
          : "${APPLE_CERTIFICATE:?APPLE_CERTIFICATE (base64 p12) is required}"
          : "${APPLE_CERTIFICATE_PASSWORD:?APPLE_CERTIFICATE_PASSWORD is required}"
          : "${KEYCHAIN_PASSWORD:?KEYCHAIN_PASSWORD is required}"

          keychain="$RUNNER_TEMP/__APP_NAME__-release.keychain-db"
          printf '%s' "$APPLE_CERTIFICATE" | base64 --decode > "$RUNNER_TEMP/developer-id.p12"
          chmod 600 "$RUNNER_TEMP/developer-id.p12"

          security delete-keychain "$keychain" 2>/dev/null || true
          security create-keychain -p "$KEYCHAIN_PASSWORD" "$keychain"
          security set-keychain-settings -lut 21600 "$keychain"
          security unlock-keychain -p "$KEYCHAIN_PASSWORD" "$keychain"
          # Developer ID intermediate keeps chain validation working on a
          # runner whose login keychain predates it.
          curl -sSL https://www.apple.com/certificateauthority/DeveloperIDG2CA.cer -o "$RUNNER_TEMP/DeveloperIDG2CA.cer"
          security import "$RUNNER_TEMP/DeveloperIDG2CA.cer" -k "$keychain" -T /usr/bin/codesign 2>/dev/null || true
          security import "$RUNNER_TEMP/developer-id.p12" -k "$keychain" \
            -P "$APPLE_CERTIFICATE_PASSWORD" -T /usr/bin/codesign -T /usr/bin/security
          security set-key-partition-list -S apple-tool:,apple:,codesign: -s \
            -k "$KEYCHAIN_PASSWORD" "$keychain"
          security list-keychains -d user -s "$keychain" "$HOME/Library/Keychains/login.keychain-db"

          identities="$(security find-identity -v -p codesigning "$keychain")"
          printf '%s\n' "$identities"
          printf '%s\n' "$identities" | grep -Fq 'Developer ID Application' || {
            echo "Developer ID Application identity is missing — check APPLE_CERTIFICATE" >&2
            exit 1
          }
          # SPM package frameworks demand DEVELOPMENT_TEAM even under Manual
          # signing; derive it from the identity name instead of a secret.
          team_id="$(printf '%s\n' "$identities" | grep -m1 'Developer ID Application' | sed -n -E 's/.*\(([A-Z0-9]{10})\).*/\1/p')"
          test -n "$team_id" || { echo "could not extract team id from identity" >&2; exit 1; }
          echo "DEVELOPMENT_TEAM=$team_id" >> "$GITHUB_ENV"
          echo "KEYCHAIN_PATH=$keychain" >> "$GITHUB_ENV"

      - name: Build app (Release, Developer ID)
        run: |
          set -euo pipefail
          xcodebuild \
            -project __XCODEPROJ__ \
            -scheme __SCHEME__ \
            -configuration Release \
            -derivedDataPath "$RUNNER_TEMP/__APP_NAME__-dd" \
            CODE_SIGN_STYLE=Manual \
            "CODE_SIGN_IDENTITY=Developer ID Application" \
            "DEVELOPMENT_TEAM=$DEVELOPMENT_TEAM" \
            CODE_SIGN_INJECT_BASE_ENTITLEMENTS=NO \
            OTHER_CODE_SIGN_FLAGS="--timestamp" \
            build \
            2>&1 | tee "$RUNNER_TEMP/build.log" | tail -40
          grep -q "BUILD SUCCEEDED" "$RUNNER_TEMP/build.log" || {
            echo "::error::Release build failed"
            exit 1
          }
          app_path="$(find "$RUNNER_TEMP/__APP_NAME__-dd/Build/Products/Release" -maxdepth 1 -type d -name '*.app' -print -quit)"
          test -n "$app_path" || { echo "no .app produced" >&2; exit 1; }
          echo "APP_PATH=$app_path" >> "$GITHUB_ENV"

      - name: Verify signature (strict)
        run: |
          set -euo pipefail
          codesign --verify --deep --strict --verbose=2 "$APP_PATH"
          codesign -dv --verbose=2 "$APP_PATH" 2>&1 | grep -E "Authority|TeamIdentifier"

      - name: Create DMG
        env:
          # Machine-local /tmp: multiple runner processes share one machine,
          # each with a DIFFERENT RUNNER_TEMP — runner.temp splits the release
          # fleet (setup's dir invisible to the build runner). /tmp does not.
          RELEASE_DIR: /tmp/__APP_NAME__-release-${{ github.run_id }}
        run: |
          set -euo pipefail
          dmg="$RELEASE_DIR/__APP_NAME__-$RELEASE_VERSION.dmg"
          hdiutil create -volname "__APP_NAME__" -srcfolder "$APP_PATH" -ov -format UDZO "$dmg"
          codesign --force --sign "Developer ID Application" --timestamp "$dmg"
          # Checksum is generated AFTER stapling (see Staple step): stapler
          # appends the ticket and MUTATES the DMG.
          echo "DMG_PATH=$dmg" >> "$GITHUB_ENV"

      - name: Notarize DMG
        run: |
          set -euo pipefail
          if [[ -n "${APPLE_API_KEY_ID:-}" && -n "${APPLE_API_ISSUER:-}" && -n "${APPLE_API_KEY_P8:-}" ]]; then
            echo "Notarizing with App Store Connect API key"
            key_path="$RUNNER_TEMP/AuthKey_${APPLE_API_KEY_ID}.p8"
            printf '%s' "$APPLE_API_KEY_P8" | base64 --decode > "$key_path"
            chmod 600 "$key_path"
            auth=(--key "$key_path" --key-id "$APPLE_API_KEY_ID" --issuer "$APPLE_API_ISSUER")
          else
            echo "Notarizing with app-specific password (configure APPLE_API_KEY_* to migrate)"
            : "${APPLE_ID:?APPLE_ID is required for password-based notarization}"
            : "${APPLE_ID_PASSWORD:?APPLE_ID_PASSWORD is required}"
            team="${APPLE_TEAM_ID:-}"
            if [ -z "$team" ]; then
              [[ "$(security find-identity -v -p codesigning "$KEYCHAIN_PATH")" =~ \(([A-Z0-9]{10})\) ]] && team="${BASH_REMATCH[1]}"
            fi
            : "${team:?APPLE_TEAM_ID is required}"
            auth=(--apple-id "$APPLE_ID" --password "$APPLE_ID_PASSWORD" --team-id "$team")
          fi
          # Capture once; a non-Accepted terminal status (or a submit error)
          # fails the step after pulling the detailed log when possible.
          if [[ -n "${auth[*]}" ]]; then
            result="$(xcrun notarytool submit "$DMG_PATH" "${auth[@]}" --wait 2>&1 || true)"
          fi
          echo "$result" | tail -20
          status="$(echo "$result" | sed -n -E 's/.*[Ss]tatus: *([A-Za-z]+).*/\1/p' | tail -1 || true)"
          if [ "$status" != "Accepted" ]; then
            submission_id="$(echo "$result" | sed -n -E 's/.*id: *([0-9a-f-]{36}).*/\1/p' | head -1 || true)"
            if [ -n "${submission_id:-}" ] && [[ "${auth[*]}" == *--key* ]]; then
              xcrun notarytool log "$submission_id" --key "${auth[1]}" --key-id "$APPLE_API_KEY_ID" --issuer "$APPLE_API_ISSUER" || true
            fi
            echo "::error::notarization did not reach Accepted (status='${status:-unknown}')"
            exit 1
          fi

      - name: Staple and Gatekeeper-check DMG
        run: |
          set -euo pipefail
          for i in 1 2 3; do
            xcrun stapler staple "$DMG_PATH" 2>&1 && break
            [ "$i" -lt 3 ] && sleep 10
          done
          xcrun stapler validate "$DMG_PATH"
          # Offline verification of the exact payload users will open: mount
          # the stapled DMG and strictly verify the contained app. spctl on a
          # DMG file itself returns "rejected: Insufficient Context" by design
          # (it assesses app bundles, not disk images).
          mount_dir="$(mktemp -d)"
          hdiutil attach "$DMG_PATH" -nobrowse -readonly -mountpoint "$mount_dir" >/dev/null
          app_in_dmg="$(find "$mount_dir" -maxdepth 2 -type d -name '*.app' -print -quit)"
          test -n "$app_in_dmg" || { echo "no .app inside DMG" >&2; hdiutil detach "$mount_dir" || true; exit 1; }
          codesign --verify --deep --strict --verbose=2 "$app_in_dmg"
          hdiutil detach "$mount_dir"
          # Checksum of the FINAL artifact, with a relative filename so the
          # .sha256 works wherever the pair is downloaded together.
          ( cd "$(dirname "$DMG_PATH")" && shasum -a 256 "$(basename "$DMG_PATH")" > "$(basename "$DMG_PATH").sha256" )
          echo "DMG verified: stapled, validates, contained app signs strictly."

      - name: Clean up signing credentials
        if: always()
        run: |
          set +e
          [ -n "${KEYCHAIN_PATH:-}" ] && security delete-keychain "$KEYCHAIN_PATH"
          security list-keychains -d user -s "$HOME/Library/Keychains/login.keychain-db" \
            /Library/Keychains/System.keychain 2>/dev/null || true
          rm -f "$RUNNER_TEMP/developer-id.p12" "$RUNNER_TEMP/DeveloperIDG2CA.cer" \
                "$RUNNER_TEMP"/AuthKey_*.p8
          true

  publish:
    name: Publish (release) / stash rehearsal artifacts
    runs-on: [self-hosted, macOS]
    timeout-minutes: 10
    needs: [setup, build]
    permissions:
      contents: write
    env:
      IS_RELEASE: ${{ needs.setup.outputs.is_release }}
      RELEASE_VERSION: ${{ needs.setup.outputs.release_version }}
    steps:
      # Rebuild artifact paths locally (runner context is step-level only);
      # github.run_id keeps the path stable so a retried publish job can
      # reuse a successful build's artifacts.
      - name: Verify artifacts exist
        env:
          IS_RELEASE: ${{ needs.setup.outputs.is_release }}
          RELEASE_DIR: /tmp/__APP_NAME__-release-${{ github.run_id }}
        run: |
          set -euo pipefail
          DMG_PATH="$RELEASE_DIR/__APP_NAME__-$RELEASE_VERSION.dmg"
          echo "DMG_PATH=$DMG_PATH" >> "$GITHUB_ENV"
          test -s "$DMG_PATH" || { echo "DMG missing from build job" >&2; exit 1; }
          test -s "$DMG_PATH.sha256" || { echo "checksum missing" >&2; exit 1; }
          ls -lh "$RELEASE_DIR"

      - name: Attach DMG to GitHub Release
        env:
          # Machine-local /tmp: multiple runner processes share one machine,
          # each with a DIFFERENT RUNNER_TEMP — runner.temp splits the release
          # fleet (setup's dir invisible to the build runner). /tmp does not.
          RELEASE_DIR: /tmp/__APP_NAME__-release-${{ github.run_id }}
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        if: env.IS_RELEASE == 'true'
        uses: softprops/action-gh-release@v2
        with:
          files: |
            ${{ env.RELEASE_DIR }}/*.dmg
            ${{ env.RELEASE_DIR }}/*.dmg.sha256
          generate_release_notes: true
          draft: false

      - name: Record rehearsal artifacts (no release touched)
        env:
          # Machine-local /tmp: multiple runner processes share one machine,
          # each with a DIFFERENT RUNNER_TEMP — runner.temp splits the release
          # fleet (setup's dir invisible to the build runner). /tmp does not.
          RELEASE_DIR: /tmp/__APP_NAME__-release-${{ github.run_id }}
        if: env.IS_RELEASE != 'true'
        uses: actions/upload-artifact@v4
        with:
          name: rehearsal-${{ github.sha }}-${{ github.run_id }}
          path: ${{ env.RELEASE_DIR }}
          retention-days: 7
          if-no-files-found: error

      - name: Summarize
        run: |
          {
            echo "## Release build"
            echo "- version: ${RELEASE_VERSION}"
            echo "- mode: $([ "$IS_RELEASE" = "true" ] && echo release || echo REHEARSAL)"
            echo "- artifact: $(basename "$DMG_PATH") (notarized + stapled, validate passed)"
          } >> "$GITHUB_STEP_SUMMARY"

  cleanup:
    name: Clean up
    runs-on: [self-hosted, macOS]
    if: always()
    needs: [setup, build, publish]
    steps:
      - name: Remove release dir
        env:
          # Machine-local /tmp: multiple runner processes share one machine,
          # each with a DIFFERENT RUNNER_TEMP — runner.temp splits the release
          # fleet (setup's dir invisible to the build runner). /tmp does not.
          RELEASE_DIR: /tmp/__APP_NAME__-release-${{ github.run_id }}
        run: rm -rf "$RELEASE_DIR"
